generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// DOC-001, DOC-002 e DOC-008: Organização, Tenant e Unidade
// -------------------------------------------------------------
model Empresa {
  id           String   @id @default(uuid())
  razaoSocial  String   @map("razao_social")
  nomeFantasia String?  @map("nome_fantasia")
  cnpj         String   @unique
  telefone     String
  cidade       String
  uf           String   @db.VarChar(2)
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  unidades         Unidade[]
  vinculos         VinculoUsuarioEmpresa[]
  auditorias       RegistroAuditoria[]
  idempotencias    ChaveIdempotencia[]
  clientes         Cliente[]
  veiculos         Veiculo[]
  vinculosCliVei   VinculoClienteVeiculo[]
  atendimentos     Atendimento[]
  diagnosticos     Diagnostico[]
  orcamentos       Orcamento[]
  versoesOrcamento VersaoOrcamento[]
  itensOrcamento   ItemOrcamento[]
  decisoesComerc   DecisaoComercial[]
  produtos         Produto[]
  movimentosEst    MovimentoEstoque[]
  reservasEst      ReservaEstoque[]
  ordensServico    OrdemServico[]
  atividadesOS     AtividadeOS[]
  inspecoesQualidade InspecaoQualidade[]
  cobrancas          Cobranca[]
  parcelasCobranca   ParcelaCobranca[]
  recebimentos       Recebimento[]
  aplicacoesReceb    AplicacaoRecebimento[]
  entregasVeiculo    EntregaVeiculo[]
  garantias          GarantiaAtendimento[]
  servicosTerceiros  ServicoTerceiro[]
  compras            Compra[]
  vendasBalcao       VendaBalcao[]

  @@map("empresas")
}

model Unidade {
  id           String   @id @default(uuid())
  empresaId    String   @map("empresa_id")
  nome         String
  ativo        Boolean  @default(true)
  principal    Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  empresa       Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vinculos      VinculoUsuarioEmpresa[]
  atendimentos  Atendimento[]
  ordensServico OrdemServico[]

  @@map("unidades")
}

// -------------------------------------------------------------
// DOC-005 e DOC-008: Identidade, Acesso e RBAC
// -------------------------------------------------------------
model Usuario {
  id           String   @id @default(uuid())
  nome         String
  email        String   @unique
  senhaHash    String   @map("senha_hash")
  ativo        Boolean  @default(true)
  superAdmin   Boolean  @default(false) @map("super_admin")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  vinculos            VinculoUsuarioEmpresa[]
  auditorias          RegistroAuditoria[]
  atendimentosAbertos Atendimento[]           @relation("UsuarioAberturaAtendimento")
  diagnosticos        Diagnostico[]           @relation("TecnicoDiagnostico")
  decisoesRegistradas DecisaoComercial[]      @relation("UsuarioDecisaoComercial")
  ordensResponsaveis  OrdemServico[]          @relation("MecanicoResponsavelOS")
  atividadesExec      AtividadeOS[]           @relation("MecanicoAtividade")
  movimentosEstoque   MovimentoEstoque[]
  inspecoesRealizadas InspecaoQualidade[]     @relation("InspetorQualidade")
  recebimentosReg     Recebimento[]           @relation("UsuarioRecebimento")
  entregasRealizadas  EntregaVeiculo[]        @relation("UsuarioEntrega")
  garantiasDecididas  GarantiaAtendimento[]   @relation("UsuarioDecisaoGarantia")
  comprasRegistradas     Compra[]              @relation("UsuarioCompra")
  vendasBalcaoRegistradas VendaBalcao[]        @relation("UsuarioVendaBalcao")

  @@map("usuarios")
}

model VinculoUsuarioEmpresa {
  id             String   @id @default(uuid())
  usuarioId      String   @map("usuario_id")
  empresaId      String   @map("empresa_id")
  unidadeId      String   @map("unidade_id")
  ativo          Boolean  @default(true)
  alcadaDesconto Decimal  @default(0.0) @map("alcada_desconto") @db.Decimal(12, 2)
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  usuario Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  unidade Unidade         @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  perfis  VinculoPerfil[]

  @@unique([usuarioId, empresaId])
  @@map("vinculos_usuario_empresa")
}

model Perfil {
  id        String   @id @default(uuid())
  codigo    String   @unique
  nome      String
  descricao String?
  criadoEm  DateTime @default(now()) @map("criado_em")

  permissoes PerfilPermissao[]
  vinculos   VinculoPerfil[]

  @@map("perfis")
}

model Permissao {
  id        String   @id @default(uuid())
  codigo    String   @unique
  nome      String
  modulo    String
  descricao String?

  perfis PerfilPermissao[]

  @@map("permissoes")
}

model PerfilPermissao {
  perfilId    String @map("perfil_id")
  permissaoId String @map("permissao_id")

  perfil    Perfil    @relation(fields: [perfilId], references: [id], onDelete: Cascade)
  permissao Permissao @relation(fields: [permissaoId], references: [id], onDelete: Cascade)

  @@id([perfilId, permissaoId])
  @@map("perfil_permissoes")
}

model VinculoPerfil {
  vinculoId String @map("vinculo_id")
  perfilId  String @map("perfil_id")

  vinculo VinculoUsuarioEmpresa @relation(fields: [vinculoId], references: [id], onDelete: Cascade)
  perfil  Perfil                @relation(fields: [perfilId], references: [id], onDelete: Cascade)

  @@id([vinculoId, perfilId])
  @@map("vinculo_perfis")
}

// -------------------------------------------------------------
// DOC-006, DOC-012 e HU-029: Auditoria Transversal
// -------------------------------------------------------------
model RegistroAuditoria {
  id           String   @id @default(uuid())
  empresaId    String   @map("empresa_id")
  unidadeId    String?  @map("unidade_id")
  usuarioId    String?  @map("usuario_id")
  operacao     String
  entidade     String
  entidadeId   String?  @map("entidade_id")
  detalhes     Json?
  ipOrigem     String?  @map("ip_origem")
  userAgent    String?  @map("user_agent")
  correlacaoId String?  @map("correlacao_id")
  criadoEm     DateTime @default(now()) @map("criado_em")

  empresa Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([empresaId, criadoEm])
  @@index([empresaId, entidade, entidadeId])
  @@map("registros_auditoria")
}

// -------------------------------------------------------------
// DOC-006, DOC-012 e HU-002: Idempotência de Mutações Críticas
// -------------------------------------------------------------
model ChaveIdempotencia {
  id           String   @id @default(uuid())
  empresaId    String   @map("empresa_id")
  chave        String
  rota         String
  statusHttp   Int      @map("status_http")
  respostaJson Json     @map("resposta_json")
  criadoEm     DateTime @default(now()) @map("criado_em")
  expiraEm     DateTime @map("expira_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([empresaId, chave])
  @@index([expiraEm])
  @@map("chaves_idempotencia")
}

// -------------------------------------------------------------
// DOC-002, DOC-007, DOC-008 e HU-006: Cadastros - Clientes
// -------------------------------------------------------------
model Cliente {
  id              String   @id @default(uuid())
  empresaId       String   @map("empresa_id")
  tipo            String   @default("FISICA")
  nomeRazao       String   @map("nome_razao")
  apelidoFantasia String?  @map("apelido_fantasia")
  cpfCnpj         String   @map("cpf_cnpj")
  telefone        String
  email           String?
  cep             String?
  logradouro      String?
  numero          String?
  bairro          String?
  cidade          String?
  uf              String?  @db.VarChar(2)
  observacoes     String?
  ativo           Boolean  @default(true)
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  empresa      Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  veiculos     VinculoClienteVeiculo[]
  atendimentos Atendimento[]

  @@unique([empresaId, cpfCnpj])
  @@index([empresaId, nomeRazao])
  @@map("clientes")
}

// -------------------------------------------------------------
// DOC-002, DOC-007, DOC-008 e HU-007: Cadastros - Veículos
// -------------------------------------------------------------
model CategoriaVeiculo {
  id        String    @id @default(uuid())
  codigo    String    @unique
  nome      String
  descricao String?
  veiculos  Veiculo[]

  @@map("categorias_veiculo")
}

model Veiculo {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  placa         String
  chassi        String?
  marca         String
  modelo        String
  anoFabricacao Int?     @map("ano_fabricacao")
  anoModelo     Int?     @map("ano_modelo")
  cor           String?
  combustivel   String?
  categoriaId   String   @map("categoria_id")
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  empresa      Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  categoria    CategoriaVeiculo        @relation(fields: [categoriaId], references: [id])
  clientes     VinculoClienteVeiculo[]
  atendimentos Atendimento[]

  @@unique([empresaId, placa])
  @@index([empresaId, placa])
  @@map("veiculos")
}

model VinculoClienteVeiculo {
  id        String   @id @default(uuid())
  empresaId String   @map("empresa_id")
  clienteId String   @map("cliente_id")
  veiculoId String   @map("veiculo_id")
  papel     String   @default("PROPRIETARIO")
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  veiculo Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, veiculoId, empresaId])
  @@map("vinculos_cliente_veiculo")
}

// -------------------------------------------------------------
// DOC-001, DOC-003, DOC-007, DOC-008 e HU-008/009: Atendimento
// -------------------------------------------------------------
model Atendimento {
  id                String    @id @default(uuid())
  empresaId         String    @map("empresa_id")
  unidadeId         String    @map("unidade_id")
  numeroSequencial  Int       @map("numero_sequencial")
  codigoFormatado   String    @map("codigo_formatado")
  clienteId         String    @map("cliente_id")
  veiculoId         String    @map("veiculo_id")
  usuarioAberturaId String    @map("usuario_abertura_id")
  status            String    @default("CONFIRMADO")
  queixaPrincipal   String    @map("queixa_principal")
  dataEntrada       DateTime  @default(now()) @map("data_entrada")
  previsaoEntrega   DateTime? @map("previsao_entrega")
  finalizadoEm      DateTime? @map("finalizado_em")
  criadoEm          DateTime  @default(now()) @map("criado_em")
  atualizadoEm      DateTime  @updatedAt @map("atualizado_em")

  empresa         Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  unidade         Unidade          @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  cliente         Cliente          @relation(fields: [clienteId], references: [id])
  veiculo         Veiculo          @relation(fields: [veiculoId], references: [id])
  usuarioAbertura Usuario          @relation("UsuarioAberturaAtendimento", fields: [usuarioAberturaId], references: [id])
  medicao         MedicaoVeiculo?
  diagnosticos    Diagnostico[]
  orcamento       Orcamento?
  ordemServico    OrdemServico?
  reservasEstoque ReservaEstoque[]
  inspecoes       InspecaoQualidade[]
  cobranca        Cobranca?
  entrega         EntregaVeiculo?
  garantiasOrigem GarantiaAtendimento[] @relation("AtendimentoOrigemGarantia")
  garantiaGerada  GarantiaAtendimento?  @relation("AtendimentoGeradoGarantia")
  servicosTerceiros ServicoTerceiro[]

  @@unique([empresaId, numeroSequencial])
  @@index([empresaId, status])
  @@index([empresaId, codigoFormatado])
  @@map("atendimentos")
}

model MedicaoVeiculo {
  id                    String   @id @default(uuid())
  empresaId             String   @map("empresa_id")
  atendimentoId         String   @unique @map("atendimento_id")
  quilometragem         Int
  nivelCombustivel      String   @default("MEIO") @map("nivel_combustivel")
  pertencesDeixados     String?  @map("pertences_deixados")
  avariasPrevias        String?  @map("avarias_previas")
  temEstepe             Boolean  @default(true) @map("tem_estepe")
  temMacaco             Boolean  @default(true) @map("tem_macaco")
  temChaveRoda          Boolean  @default(true) @map("tem_chave_roda")
  temManualChaveReserva Boolean  @default(false) @map("tem_manual_chave_reserva")
  criadoEm              DateTime @default(now()) @map("criado_em")

  atendimento Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)

  @@map("medicoes_veiculo")
}

// -------------------------------------------------------------
// DOC-003, DOC-007, DOC-008 e HU-010: Diagnóstico Técnico
// -------------------------------------------------------------
model Diagnostico {
  id                      String   @id @default(uuid())
  empresaId               String   @map("empresa_id")
  atendimentoId           String   @map("atendimento_id")
  responsavelTecnicoId    String   @map("responsavel_tecnico_id")
  relatoTecnico           String   @map("relato_tecnico")
  constatacoes            String
  causaRaiz               String?  @map("causa_raiz")
  conclusao               String   @default("PROCEDE_REPARO")
  procedimentoRecomendado String?  @map("procedimento_recomendado")
  criadoEm                DateTime @default(now()) @map("criado_em")
  atualizadoEm            DateTime @updatedAt @map("atualizado_em")

  empresa            Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  atendimento        Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  responsavelTecnico Usuario     @relation("TecnicoDiagnostico", fields: [responsavelTecnicoId], references: [id])

  @@index([empresaId, atendimentoId])
  @@map("diagnosticos")
}

// -------------------------------------------------------------
// DOC-001, DOC-003, DOC-008, HU-011 a HU-013: Orçamento Versionado
// -------------------------------------------------------------
model Orcamento {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  atendimentoId String   @unique @map("atendimento_id")
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")

  empresa     Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  atendimento Atendimento       @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  versoes     VersaoOrcamento[]

  @@map("orcamentos")
}

model VersaoOrcamento {
  id                    String    @id @default(uuid())
  empresaId             String    @map("empresa_id")
  orcamentoId           String    @map("orcamento_id")
  numeroVersao          Int       @map("numero_versao")
  status                String    @default("RASCUNHO")
  validadeDias          Int       @default(10) @map("validade_dias")
  apresentadaEm         DateTime? @map("apresentada_em")
  observacoesComerciais String?   @map("observacoes_comerciais")
  valorTotalPecas       Decimal   @default(0.0) @map("valor_total_pecas") @db.Decimal(12, 2)
  valorTotalServicos    Decimal   @default(0.0) @map("valor_total_servicos") @db.Decimal(12, 2)
  valorDescontoGeral    Decimal   @default(0.0) @map("valor_desconto_geral") @db.Decimal(12, 2)
  valorTotalFinal       Decimal   @default(0.0) @map("valor_total_final") @db.Decimal(12, 2)
  criadoEm              DateTime  @default(now()) @map("criado_em")
  atualizadoEm          DateTime  @updatedAt @map("atualizado_em")

  empresa   Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  orcamento Orcamento          @relation(fields: [orcamentoId], references: [id], onDelete: Cascade)
  itens     ItemOrcamento[]
  decisoes  DecisaoComercial[]

  @@unique([orcamentoId, numeroVersao])
  @@index([empresaId, status])
  @@map("versoes_orcamento")
}

model ItemOrcamento {
  id                   String   @id @default(uuid())
  empresaId            String   @map("empresa_id")
  versaoOrcamentoId    String   @map("versao_orcamento_id")
  tipo                 String   @default("SERVICO")
  descricao            String
  quantidade           Decimal  @default(1.0) @db.Decimal(12, 3)
  unidadeMedida        String   @default("UN") @map("unidade_medida")
  valorUnitario        Decimal  @default(0.0) @map("valor_unitario") @db.Decimal(12, 2)
  valorDesconto        Decimal  @default(0.0) @map("valor_desconto") @db.Decimal(12, 2)
  valorTotal           Decimal  @default(0.0) @map("valor_total") @db.Decimal(12, 2)
  decisao              String   @default("PENDENTE")
  justificativaDecisao String?  @map("justificativa_decisao")
  criadoEm             DateTime @default(now()) @map("criado_em")

  empresa         Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  versaoOrcamento VersaoOrcamento @relation(fields: [versaoOrcamentoId], references: [id], onDelete: Cascade)

  @@index([empresaId, versaoOrcamentoId])
  @@map("itens_orcamento")
}

model DecisaoComercial {
  id                   String   @id @default(uuid())
  empresaId            String   @map("empresa_id")
  versaoOrcamentoId    String   @map("versao_orcamento_id")
  canal                String   @default("WHATSAPP")
  autorizadorNome      String   @map("autorizador_nome")
  documentoAutorizador String?  @map("documento_autorizador")
  evidenciaTexto       String?  @map("evidencia_texto")
  usuarioRegistradorId String   @map("usuario_registrador_id")
  dataDecisao          DateTime @default(now()) @map("data_decisao")
  criadoEm             DateTime @default(now()) @map("criado_em")

  empresa            Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  versaoOrcamento    VersaoOrcamento @relation(fields: [versaoOrcamentoId], references: [id], onDelete: Cascade)
  usuarioRegistrador Usuario         @relation("UsuarioDecisaoComercial", fields: [usuarioRegistradorId], references: [id])

  @@index([empresaId, versaoOrcamentoId])
  @@map("decisoes_comerciais")
}

// -------------------------------------------------------------
// DOC-002, DOC-004, DOC-008 e HU-017/018: Estoque e Produtos
// -------------------------------------------------------------
model Produto {
  id             String   @id @default(uuid())
  empresaId      String   @map("empresa_id")
  codigo         String
  codigoBarras   String?  @map("codigo_barras")
  descricao      String
  localizacao    String?  // Ex: Corredor A - Prateleira 2 - Gaveta 4
  fotoUrl            String?            @map("foto_url") // URL ou base64 da foto da peça
  unidadeMedida      String             @default("UN") @map("unidade_medida")
  precoCusto         Decimal            @default(0.0) @map("preco_custo") @db.Decimal(12, 2)
  custoMedio         Decimal            @default(0.0) @map("custo_medio") @db.Decimal(12, 2)
  ultimoPrecoCompra  Decimal?           @map("ultimo_preco_compra") @db.Decimal(12, 2)
  ultimoPrecoVenda   Decimal?           @map("ultimo_preco_venda") @db.Decimal(12, 2)
  precoVenda         Decimal            @default(0.0) @map("preco_venda") @db.Decimal(12, 2)
  marca              String?            // Ex: Bosch, Mann-Filter, Cofap, Motul
  modelo             String?            // Ex: Sintético 5W-30 API SP, Linha Cerâmica
  categoria          String?            // Ex: Lubrificantes & Fluidos, Freios, Filtros, Suspensão
  codigoOriginal     String?            @map("codigo_original") // OEM Part Number da montadora
  aplicacoes         String?            // Aplicação veicular (ex: Corolla 1.8/2.0 2015-2023, Civic 2.0)
  especificacoes     String?            // Normas técnicas (ex: API SP, ACEA C3, DOT 4)
  lote               String?            // Número do lote do fabricante
  dataValidade       DateTime?          @map("data_validade") // Validade (vital para óleos, aditivos, fluidos)
  saldoFisico        Decimal            @default(0.0) @map("saldo_fisico") @db.Decimal(12, 3)
  saldoReservado     Decimal            @default(0.0) @map("saldo_reservado") @db.Decimal(12, 3)
  estoqueMinimo      Decimal            @default(0.0) @map("estoque_minimo") @db.Decimal(12, 3)
  ativo              Boolean            @default(true)
  criadoEm           DateTime           @default(now()) @map("criado_em")
  atualizadoEm       DateTime           @updatedAt @map("atualizado_em")

  empresa          Empresa            @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  movimentos       MovimentoEstoque[]
  reservas         ReservaEstoque[]
  itensCompra      ItemCompra[]
  itensVendaBalcao ItemVendaBalcao[]

  @@unique([empresaId, codigo])
  @@index([empresaId, descricao])
  @@index([empresaId, codigoBarras])
  @@index([empresaId, marca])
  @@index([empresaId, categoria])
  @@map("produtos")
}

model MovimentoEstoque {
  id                     String   @id @default(uuid())
  empresaId              String   @map("empresa_id")
  produtoId              String   @map("produto_id")
  tipo                   String   // ENTRADA, RESERVA, LIBERACAO_RESERVA, CONSUMO, DEVOLUCAO, AJUSTE_POSITIVO, AJUSTE_NEGATIVO
  quantidade             Decimal  @db.Decimal(12, 3)
  saldoFisicoAnterior    Decimal  @map("saldo_fisico_anterior") @db.Decimal(12, 3)
  saldoFisicoNovo        Decimal  @map("saldo_fisico_novo") @db.Decimal(12, 3)
  saldoReservadoAnterior Decimal  @map("saldo_reservado_anterior") @db.Decimal(12, 3)
  saldoReservadoNovo     Decimal  @map("saldo_reservado_novo") @db.Decimal(12, 3)
  origemDocumento        String?  @map("origem_documento")
  usuarioId              String   @map("usuario_id")
  motivo                 String?
  criadoEm               DateTime @default(now()) @map("criado_em")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  usuario Usuario @relation(fields: [usuarioId], references: [id])

  @@index([empresaId, produtoId])
  @@map("movimentos_estoque")
}

model ReservaEstoque {
  id             String   @id @default(uuid())
  empresaId      String   @map("empresa_id")
  produtoId      String   @map("produto_id")
  atendimentoId  String   @map("atendimento_id")
  ordemServicoId String?  @map("ordem_servico_id")
  quantidade     Decimal  @db.Decimal(12, 3)
  status         String   @default("ATIVA") // ATIVA, CONSUMIDA, CANCELADA
  criadoEm       DateTime @default(now()) @map("criado_em")

  empresa      Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  produto      Produto       @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  atendimento  Atendimento   @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  ordemServico OrdemServico? @relation(fields: [ordemServicoId], references: [id], onDelete: SetNull)

  @@index([empresaId, produtoId])
  @@index([empresaId, atendimentoId])
  @@map("reservas_estoque")
}

// -------------------------------------------------------------
// DOC-001, DOC-003, DOC-007, DOC-008, HU-014 e HU-015: Ordem de Serviço
// -------------------------------------------------------------
model OrdemServico {
  id                    String    @id @default(uuid())
  empresaId             String    @map("empresa_id")
  unidadeId             String    @map("unidade_id")
  atendimentoId         String    @unique @map("atendimento_id") // No máximo uma OS por atendimento no MVP
  numeroOS              Int       @map("numero_os")
  codigoFormatado       String    @map("codigo_formatado") // Ex: OS-2026-0001
  status                String    @default("PLANEJADA") // PLANEJADA, EM_ANDAMENTO, PAUSADA, CONCLUIDA, CANCELADA
  responsavelMecanicoId String?   @map("responsavel_mecanico_id")
  dataInicio            DateTime? @map("data_inicio")
  dataConclusao         DateTime? @map("data_conclusao")
  observacoesTecnicas   String?   @map("observacoes_tecnicas")
  criadoEm              DateTime  @default(now()) @map("criado_em")
  atualizadoEm          DateTime  @updatedAt @map("atualizado_em")

  empresa             Empresa          @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  unidade             Unidade          @relation(fields: [unidadeId], references: [id], onDelete: Cascade)
  atendimento         Atendimento      @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  responsavelMecanico Usuario?         @relation("MecanicoResponsavelOS", fields: [responsavelMecanicoId], references: [id], onDelete: SetNull)
  atividades          AtividadeOS[]
  reservasEstoque     ReservaEstoque[]

  @@unique([empresaId, numeroOS])
  @@index([empresaId, status])
  @@map("ordens_servico")
}

model AtividadeOS {
  id                    String    @id @default(uuid())
  empresaId             String    @map("empresa_id")
  ordemServicoId        String    @map("ordem_servico_id")
  itemOrcamentoId       String?   @map("item_orcamento_id")
  descricao             String
  status                String    @default("PENDENTE") // PENDENTE, EM_EXECUCAO, PAUSADA, CONCLUIDA, CANCELADA
  mecanicoId            String?   @map("mecanico_id")
  tempoEstimadoMinutos  Int       @default(60) @map("tempo_estimado_minutos")
  tempoRealizadoMinutos Int       @default(0) @map("tempo_realizado_minutos")
  iniciadoEm            DateTime? @map("iniciado_em")
  concluidoEm           DateTime? @map("concluido_em")
  motivoPausa           String?   @map("motivo_pausa")
  criadoEm              DateTime  @default(now()) @map("criado_em")
  atualizadoEm          DateTime  @updatedAt @map("atualizado_em")

  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordemServico OrdemServico @relation(fields: [ordemServicoId], references: [id], onDelete: Cascade)
  mecanico     Usuario?     @relation("MecanicoAtividade", fields: [mecanicoId], references: [id], onDelete: SetNull)

  @@index([empresaId, ordemServicoId])
  @@map("atividades_os")
}

// -------------------------------------------------------------
// DOC-002, DOC-003, DOC-008 e HU-019: Inspeção Final de Qualidade
// -------------------------------------------------------------
model InspecaoQualidade {
  id                 String   @id @default(uuid())
  empresaId          String   @map("empresa_id")
  atendimentoId      String   @map("atendimento_id")
  inspetorId         String   @map("inspetor_id")
  resultado          String   @default("APROVADO_TOTAL") // APROVADO_TOTAL, APROVADO_COM_RESSALVA, REPROVADO
  constatacoes       String
  itensInspecionados Json     @map("itens_inspecionados")
  quilometragemTeste Int?     @map("quilometragem_teste")
  criadoEm           DateTime @default(now()) @map("criado_em")

  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  atendimento Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  inspetor    Usuario     @relation("InspetorQualidade", fields: [inspetorId], references: [id])

  @@index([empresaId, atendimentoId])
  @@map("inspecoes_qualidade")
}

// -------------------------------------------------------------
// DOC-002, DOC-003, DOC-004 e HU-020: Financeiro - Cobrança
// -------------------------------------------------------------
model Cobranca {
  id              String   @id @default(uuid())
  empresaId       String   @map("empresa_id")
  atendimentoId   String   @unique @map("atendimento_id")
  codigoFormatado String   @map("codigo_formatado") // Ex: COB-2026-0001
  numeroSequencial Int     @map("numero_sequencial")
  valorTotal      Decimal  @map("valor_total") @db.Decimal(12, 2)
  valorDesconto   Decimal  @default(0.0) @map("valor_desconto") @db.Decimal(12, 2)
  valorLiquido    Decimal  @map("valor_liquido") @db.Decimal(12, 2)
  valorRecebido   Decimal  @default(0.0) @map("valor_recebido") @db.Decimal(12, 2)
  status          String   @default("PENDENTE") // PENDENTE, PARCIALMENTE_LIQUIDADA, LIQUIDADA, CANCELADA
  observacoes     String?
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  empresa      Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  atendimento  Atendimento       @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  parcelas     ParcelaCobranca[]
  recebimentos Recebimento[]

  @@unique([empresaId, numeroSequencial])
  @@index([empresaId, status])
  @@map("cobrancas")
}

model ParcelaCobranca {
  id             String   @id @default(uuid())
  empresaId      String   @map("empresa_id")
  cobrancaId     String   @map("cobranca_id")
  numeroParcela  Int      @map("numero_parcela")
  valor          Decimal  @db.Decimal(12, 2)
  valorPago      Decimal  @default(0.0) @map("valor_pago") @db.Decimal(12, 2)
  saldoDevedor   Decimal  @map("saldo_devedor") @db.Decimal(12, 2)
  dataVencimento DateTime @map("data_vencimento")
  status         String   @default("PENDENTE") // PENDENTE, PAGA, VENCIDA, CANCELADA
  criadoEm       DateTime @default(now()) @map("criado_em")
  atualizadoEm   DateTime @updatedAt @map("atualizado_em")

  empresa    Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cobranca   Cobranca               @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)
  aplicacoes AplicacaoRecebimento[]

  @@unique([cobrancaId, numeroParcela])
  @@index([empresaId, status])
  @@map("parcelas_cobranca")
}

// -------------------------------------------------------------
// DOC-002, DOC-004 e HU-021: Financeiro - Recebimentos
// -------------------------------------------------------------
model Recebimento {
  id                  String   @id @default(uuid())
  empresaId           String   @map("empresa_id")
  cobrancaId          String   @map("cobranca_id")
  codigoFormatado     String   @map("codigo_formatado") // Ex: REC-2026-0001
  numeroSequencial    Int      @map("numero_sequencial")
  valor               Decimal  @db.Decimal(12, 2)
  meioPagamento       String   @map("meio_pagamento") // DINHEIRO, PIX, CARTAO_CREDITO, CARTAO_DEBITO, BOLETO, TRANSFERENCIA
  detalhes            String?
  usuarioId           String   @map("usuario_id")
  dataHoraRecebimento DateTime @default(now()) @map("data_hora_recebimento")
  criadoEm            DateTime @default(now()) @map("criado_em")

  empresa    Empresa                @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cobranca   Cobranca               @relation(fields: [cobrancaId], references: [id], onDelete: Cascade)
  usuario    Usuario                @relation("UsuarioRecebimento", fields: [usuarioId], references: [id])
  aplicacoes AplicacaoRecebimento[]

  @@unique([empresaId, numeroSequencial])
  @@index([empresaId, cobrancaId])
  @@map("recebimentos")
}

model AplicacaoRecebimento {
  id            String   @id @default(uuid())
  empresaId     String   @map("empresa_id")
  recebimentoId String   @map("recebimento_id")
  parcelaId     String   @map("parcela_id")
  valorAplicado Decimal  @map("valor_aplicado") @db.Decimal(12, 2)
  criadoEm      DateTime @default(now()) @map("criado_em")

  empresa     Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  recebimento Recebimento     @relation(fields: [recebimentoId], references: [id], onDelete: Cascade)
  parcela     ParcelaCobranca @relation(fields: [parcelaId], references: [id], onDelete: Cascade)

  @@index([empresaId, recebimentoId])
  @@index([empresaId, parcelaId])
  @@map("aplicacoes_recebimento")
}

// -------------------------------------------------------------
// DOC-002, DOC-003, DOC-004 e HU-022: Liberação e Entrega do Veículo
// -------------------------------------------------------------
model EntregaVeiculo {
  id                       String   @id @default(uuid())
  empresaId                String   @map("empresa_id")
  atendimentoId            String   @unique @map("atendimento_id")
  condicaoDevolucao        String   @map("condicao_devolucao") // APROVADO_TOTAL, APROVADO_COM_RESSALVA, SEM_REPARO_RETIRADA_SOLICITADA, INOPERANTE
  nomeRecebedor            String   @map("nome_recebedor")
  documentoRecebedor       String?  @map("documento_recebedor")
  quilometragemSaida       Int      @map("quilometragem_saida")
  usuarioEntregaId         String   @map("usuario_entrega_id")
  liberadaComDebito        Boolean  @default(false) @map("liberada_com_debito")
  motivoLiberacaoComDebito String?  @map("motivo_liberacao_com_debito")
  observacoes              String?
  dataHoraEntrega          DateTime @default(now()) @map("data_hora_entrega")
  criadoEm                 DateTime @default(now()) @map("criado_em")

  empresa        Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  atendimento    Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)
  usuarioEntrega Usuario     @relation("UsuarioEntrega", fields: [usuarioEntregaId], references: [id])

  @@map("entregas_veiculo")
}

// -------------------------------------------------------------
// DOC-002, DOC-004 e HU-023: Garantias e Retorno de Atendimento
// -------------------------------------------------------------
model GarantiaAtendimento {
  id                    String    @id @default(uuid())
  empresaId             String    @map("empresa_id")
  atendimentoOrigemId   String    @map("atendimento_origem_id")
  atendimentoGarantiaId String?   @unique @map("atendimento_garantia_id")
  codigoFormatado       String    @map("codigo_formatado") // Ex: GAR-2026-0001
  numeroSequencial      Int       @map("numero_sequencial")
  reclamacaoCliente     String    @map("reclamacao_cliente")
  parecerTecnico        String    @map("parecer_tecnico")
  decisao               String    @map("decisao") // COBERTA_TOTAL, COBERTA_PARCIAL, RECUSADA
  justificativaDecisao  String    @map("justificativa_decisao")
  itensCobertos         String[]  @default([]) @map("itens_cobertos")
  usuarioDecisaoId      String    @map("usuario_decisao_id")
  dataDecisao           DateTime  @default(now()) @map("data_decisao")
  criadoEm              DateTime  @default(now()) @map("criado_em")
  atualizadoEm          DateTime  @updatedAt @map("atualizado_em")

  empresa             Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  atendimentoOrigem   Atendimento  @relation("AtendimentoOrigemGarantia", fields: [atendimentoOrigemId], references: [id], onDelete: Cascade)
  atendimentoGarantia Atendimento? @relation("AtendimentoGeradoGarantia", fields: [atendimentoGarantiaId], references: [id], onDelete: SetNull)
  usuarioDecisao      Usuario      @relation("UsuarioDecisaoGarantia", fields: [usuarioDecisaoId], references: [id])

  @@unique([empresaId, numeroSequencial])
  @@index([empresaId, atendimentoOrigemId])
  @@map("garantias_atendimento")
}

// -------------------------------------------------------------
// DOC-002, DOC-004 e HU-025: Serviços de Terceiros e Retíficas
// -------------------------------------------------------------
model ServicoTerceiro {
  id                  String    @id @default(uuid())
  empresaId           String    @map("empresa_id")
  atendimentoId       String    @map("atendimento_id")
  fornecedorNome      String    @map("fornecedor_nome")
  descricaoServico    String    @map("descricao_servico")
  valorCusto          Decimal   @default(0.0) @map("valor_custo") @db.Decimal(12, 2)
  valorCobradoCliente Decimal   @default(0.0) @map("valor_cobrado_cliente") @db.Decimal(12, 2)
  status              String    @default("ENVIADO") @map("status") // ENVIADO, EM_EXECUCAO, RECEBIDO, CANCELADO
  dataEnvio           DateTime  @default(now()) @map("data_envio")
  dataRetornoPrevista DateTime? @map("data_retorno_prevista")
  dataRecebimento     DateTime? @map("data_recebimento")
  observacoes         String?
  observacoesRetorno  String?   @map("observacoes_retorno")
  criadoEm            DateTime  @default(now()) @map("criado_em")
  atualizadoEm        DateTime  @updatedAt @map("atualizado_em")

  empresa     Empresa     @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  atendimento Atendimento @relation(fields: [atendimentoId], references: [id], onDelete: Cascade)

  @@index([empresaId, atendimentoId])
  @@map("servicos_terceiros")
}

// -------------------------------------------------------------
// Módulo de Compras, Fornecedores e Notas Fiscais
// -------------------------------------------------------------
model Compra {
  id              String       @id @default(uuid())
  empresaId       String       @map("empresa_id")
  numeroNota      String?      @map("numero_nota")
  serie           String?      @map("serie")
  chaveAcesso     String?      @map("chave_acesso")
  fornecedorNome  String       @map("fornecedor_nome")
  fornecedorCnpj  String?      @map("fornecedor_cnpj")
  status          String       @default("RECEBIDO") @map("status") // COTACAO, PEDIDO_CONFIRMADO, RECEBIDO, CANCELADO
  dataEmissao     DateTime?    @map("data_emissao")
  dataRecebimento DateTime?    @map("data_recebimento")
  valorTotal      Decimal      @default(0.0) @map("valor_total") @db.Decimal(12, 2)
  observacoes     String?
  usuarioId       String       @map("usuario_id")
  criadoEm        DateTime     @default(now()) @map("criado_em")
  atualizadoEm    DateTime     @updatedAt @map("atualizado_em")

  empresa Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario      @relation("UsuarioCompra", fields: [usuarioId], references: [id])
  itens   ItemCompra[]

  @@index([empresaId, status])
  @@index([empresaId, numeroNota])
  @@map("compras")
}

model ItemCompra {
  id            String   @id @default(uuid())
  compraId      String   @map("compra_id")
  produtoId     String   @map("produto_id")
  quantidade    Decimal  @db.Decimal(12, 3)
  precoUnitario Decimal  @map("preco_unitario") @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  criadoEm      DateTime @default(now()) @map("criado_em")

  compra  Compra  @relation(fields: [compraId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([compraId, produtoId])
  @@map("itens_compra")
}

// -------------------------------------------------------------
// Módulo Dedicado de Vendas Balcão
// -------------------------------------------------------------
model VendaBalcao {
  id               String            @id @default(uuid())
  empresaId        String            @map("empresa_id")
  codigoVenda      String            @map("codigo_venda") // Ex: VB-2026-0001
  numeroSequencial Int               @map("numero_sequencial")
  clienteNome      String            @default("Consumidor Final") @map("cliente_nome")
  clienteDocumento String?           @map("cliente_documento") // CPF/CNPJ
  clienteTelefone  String?           @map("cliente_telefone")
  formaPagamento   String            @default("PIX") @map("forma_pagamento") // PIX, CARTAO_DEBITO, CARTAO_CREDITO, DINHEIRO
  subtotal         Decimal           @default(0.0) @db.Decimal(12, 2)
  desconto         Decimal           @default(0.0) @db.Decimal(12, 2)
  valorTotal       Decimal           @default(0.0) @map("valor_total") @db.Decimal(12, 2)
  status           String            @default("CONCLUIDA") @map("status") // CONCLUIDA, CANCELADA
  observacoes      String?
  usuarioId        String            @map("usuario_id")
  criadoEm         DateTime          @default(now()) @map("criado_em")
  atualizadoEm     DateTime          @updatedAt @map("atualizado_em")

  empresa Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuario Usuario           @relation("UsuarioVendaBalcao", fields: [usuarioId], references: [id])
  itens   ItemVendaBalcao[]

  @@unique([empresaId, numeroSequencial])
  @@unique([empresaId, codigoVenda])
  @@index([empresaId, status])
  @@map("vendas_balcao")
}

model ItemVendaBalcao {
  id            String   @id @default(uuid())
  vendaId       String   @map("venda_id")
  produtoId     String   @map("produto_id")
  quantidade    Decimal  @db.Decimal(12, 3)
  precoUnitario Decimal  @map("preco_unitario") @db.Decimal(12, 2)
  custoUnitario Decimal  @default(0.0) @map("custo_unitario") @db.Decimal(12, 2)
  subtotal      Decimal  @db.Decimal(12, 2)
  criadoEm      DateTime @default(now()) @map("criado_em")

  venda   VendaBalcao @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto     @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@index([vendaId, produtoId])
  @@map("itens_venda_balcao")
}

