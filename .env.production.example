# Ambiente
NODE_ENV=production
PORT=3333
HOST=0.0.0.0

# Banco de Dados PostgreSQL 18
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_segura_aqui
POSTGRES_DB=vortex_auto
DATABASE_URL="postgresql://postgres:sua_senha_segura_aqui@localhost:5432/vortex_auto?schema=public"

# Segurança e Criptografia
JWT_SECRET=gere_uma_chave_aleatoria_longa_com_ao_menos_64_caracteres_hex_ou_base64

# Domínios e CORS
CORS_ORIGIN="https://www.vortexauto.com.br,https://vortexauto.com.br"
VITE_API_URL="https://www.vortexauto.com.br/api"
